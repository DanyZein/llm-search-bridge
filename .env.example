# llm-search-bridge configuration.
#
# Copy to .env and edit. The bridge reads plain environment variables and does
# not parse this file itself, so load it with your init system (systemd
# EnvironmentFile=) or in a shell:
#
#     set -a; . ./.env; set +a
#
# Pick one of the three preset blocks at the bottom and uncomment it.

# ---------------------------------------------------------------------------
# Shared settings
# ---------------------------------------------------------------------------

# Interface and port. The default is reachable only from this machine. Set
# 0.0.0.0 when the client is in a container or on another host, and set a
# token when you do.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8899

# Shared secret. Clients send it as "Authorization: Bearer <value>".
# Leave empty to disable authentication.
BRIDGE_AUTH_TOKEN=change-me

# Upstream request timeout, in seconds.
BRIDGE_TIMEOUT=180

# Ceiling applied to the "count" the client asks for.
BRIDGE_MAX_RESULTS=10

# ---------------------------------------------------------------------------
# Preset 1: DeepSeek (Anthropic-format endpoint)
# ---------------------------------------------------------------------------

BRIDGE_FLAVOR=anthropic
BRIDGE_BASE_URL=https://api.deepseek.com/anthropic
BRIDGE_MODEL=deepseek-flash
BRIDGE_API_KEY=sk-your-deepseek-key

# ---------------------------------------------------------------------------
# Preset 2: Anthropic
# ---------------------------------------------------------------------------

# BRIDGE_FLAVOR=anthropic
# BRIDGE_BASE_URL=https://api.anthropic.com
# BRIDGE_MODEL=a-model-your-account-can-use
# BRIDGE_API_KEY=sk-ant-your-key

# ---------------------------------------------------------------------------
# Preset 3: OpenAI (Responses API, server-side web_search tool)
# ---------------------------------------------------------------------------

# BRIDGE_FLAVOR=openai
# BRIDGE_BASE_URL=https://api.openai.com
# BRIDGE_MODEL=a-model-that-supports-the-web-search-tool
# BRIDGE_API_KEY=sk-your-openai-key

# ---------------------------------------------------------------------------
# anthropic flavor only. Ignored when BRIDGE_FLAVOR=openai.
# ---------------------------------------------------------------------------

# The provider's search tool version string. Newer strings exist
# (web_search_20260209, web_search_20260318) but not every compatible endpoint
# accepts them, so the oldest one is the default.
# BRIDGE_WEB_SEARCH_TOOL=web_search_20250305

# Cap on how many searches the model may run per request.
# BRIDGE_MAX_USES=3
